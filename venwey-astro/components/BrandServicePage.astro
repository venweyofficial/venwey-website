
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import WhatsAppFloat from "./WhatsAppFloat.astro";

interface Props {
  title: string;
  description: string;
  lead: string;
  detail: string;
  seoTitle?: string;
}

const {
  title,
  description,
  lead,
  detail,
  seoTitle
} = Astro.props;

const pageTitle = seoTitle || `${title} | Venwey`;
---

<BaseLayout
  title={pageTitle}
  description={description}
>
  <Header />

  <main id="main-content">

    <section
      class="service-detail section-pad"
      aria-labelledby="service-title"
    >

      <div class="container service-detail-content">

        <!-- Breadcrumb navigation -->
        <nav aria-label="Breadcrumb" class="service-breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services/brand/">Brand</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <!-- Service content -->
        <p class="eyebrow">Venwey Brand · Branding & Design</p>

        <h1 id="service-title">{title}</h1>

        <p class="service-detail-lead">
          {lead}
        </p>

        <p>
          {detail}
        </p>

        <!-- Conversion and internal links -->
        <div class="service-detail-actions">

          <a
            class="button button-dark"
            href="/contact/"
            data-service="Brand"
            aria-label={`Enquire about ${title} services at Venwey`}
          >
            Enquire about {title}
          </a>

          <a
            class="underlined-link"
            href="/services/brand/"
          >
            Explore all Brand services
          </a>

        </div>

      </div>

    </section>

  </main>

  <Footer />
  <WhatsAppFloat />

</BaseLayout>
