<section class="statement section-pad" id="vision">
  <div class="container">
    <p class="eyebrow">Our direction</p>
    <div class="statement-grid">
      <article class="statement-block vision-block">
        <span class="statement-number">Vision</span>
        <h2>Make ambitious<br>ideas matter.</h2>
        <p>To be a launchpad where student technocrats and emerging innovators bridge the divide between raw ideas
          and industry-defining ventures.</p>
      </article>
      <article class="statement-block mission-block">
        <span class="statement-number">Mission</span>
        <h2>Bring the pieces<br>together.</h2>
        <p>To unite engineering excellence, meaningful brand storytelling, and strategic market expansion under one
          structured ecosystem.</p>
      </article>
    </div>
    <div class="philosophy"><span>Our philosophy</span><strong>Way of Ventures.</strong><span
        class="philosophy-mark mark-slot mark-slot--small"><img src="/assets/w-mark.png" alt=""
          onerror="this.parentElement.classList.add('is-empty');this.remove()"><em class="slot-label">W
          mark<br><small>assets/w-mark.png</small></em></span></div>
  </div>
</section>
