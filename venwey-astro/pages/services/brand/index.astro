---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import BrandServices from "../../../components/BrandServices.astro";
import Footer from "../../../components/Footer.astro";
import WhatsAppFloat from "../../../components/WhatsAppFloat.astro";
---

<BaseLayout
  title="Venwey Brand | Branding, Visual Identity and Design"
  description="Explore Venwey Brand services: branding, visual identity, graphic design, and creative direction."
>
  <Header />
  <main id="main-content">
    <section class="service-detail section-pad" aria-labelledby="service-title">
      <div class="container service-detail-content">
        <nav aria-label="Breadcrumb" class="service-breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Brand Services</span>
        </nav>
        <p class="eyebrow">Venwey Brand · Branding &amp; Design</p>
        <h1 id="service-title">Brand Services</h1>
        <p class="service-detail-lead">
          Build a distinctive brand with strategy, visual identity, design, and creative direction working together.
        </p>
        <p>
          Explore Venwey Brand services and find the right support for your business, from a clear brand foundation to consistent creative execution.
        </p>
        <div class="service-detail-actions">
          <a class="button button-dark" href="/contact/" data-service="Brand">
            Discuss a brand project
          </a>
        </div>
      </div>
    </section>
    <BrandServices />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
