
---
interface Props {
  showPopup?: boolean;
}

const { showPopup = true } = Astro.props;

const services = [
  { value: "Brand strategy and visual identity", label: "Branding & visual identity" },
  { value: "Digital product development", label: "Website & digital product development" },
  { value: "Digital marketing and SEO", label: "Digital marketing & SEO" },
  { value: "Content strategy and growth planning", label: "Content & business growth" },
  { value: "General enquiry", label: "Something else" },
];
---

<section class="contact section-pad" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">

    <div class="contact-copy">
      <p class="eyebrow">Contact Venwey</p>

      <h2 id="contact-title">
        Let's build<br>
        something <em>meaningful.</em>
      </h2>

      <p>
        Looking for branding, digital product development or digital
        marketing support? Tell us about your business goals.
        Let's find the right way to move your venture forward.
      </p>

      <a
        class="contact-email"
        href="mailto:venweyofficial@gmail.com"
        aria-label="Email Venwey at venweyofficial@gmail.com"
      >
        venweyofficial@gmail.com <span aria-hidden="true">↗</span>
      </a>

      <a
        class="contact-phone"
        href="tel:+919496011781"
        aria-label="Call Venwey at +91 9496011781"
      >
        +91 9496011781
      </a>
    </div>

    <form class="contact-form" id="contactForm">
      <label for="name">Your name</label>
      <input
        id="name"
        name="name"
        type="text"
        placeholder="Enter your name"
        autocomplete="name"
        required
      >

      <label for="email">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      >

      <label for="service">What do you need help with?</label>
      <select id="service" name="service">
        <option value="Not sure yet">Select a service</option>
        {services.map((service) => (
          <option value={service.value}>{service.label}</option>
        ))}
      </select>

      <label for="message">Tell us about your project</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="Share your ideas, goals or project requirements..."
        required
      ></textarea>

      <button class="button button-gold" type="submit">
        Send enquiry <span aria-hidden="true">↗</span>
      </button>

      <p class="form-note">
        Your email app will open with your enquiry ready to send.
        Review <a href="/privacy-policy/">how we handle your information</a>.
      </p>

      <p
        class="form-status"
        id="formStatus"
        role="status"
        aria-live="polite"
      ></p>
    </form>

  </div>
</section>

{showPopup && (
  <dialog
    class="contact-dialog"
    id="contactDialog"
    aria-labelledby="contactDialogTitle"
  >
    <div class="contact-dialog-panel">

      <button
        class="contact-dialog-close"
        type="button"
        aria-label="Close contact window"
        data-close-contact-dialog
      >
        <span aria-hidden="true"></span>
      </button>

      <div class="contact-dialog-grid">

        <div class="contact-copy">
          <p class="eyebrow">Contact Venwey</p>

          <h2 id="contactDialogTitle">
            Start a<br>
            conversation.
          </h2>

          <p>
            Tell us about the work you have in mind and the support you need.
            We’ll help you find a useful next step for your venture.
          </p>

          <a class="contact-email" href="mailto:venweyofficial@gmail.com" aria-label="Email Venwey">
            Email our team
          </a>

          <a class="contact-phone" href="tel:+919496011781" aria-label="Call Venwey">
            Call Venwey
          </a>
        </div>

        <form class="contact-form" id="contactPopupForm">

          <label for="popupName">Your name</label>
          <input
            id="popupName"
            name="name"
            type="text"
            placeholder="Enter your name"
            autocomplete="name"
            required
          >

          <label for="popupEmail">Email address</label>
          <input
            id="popupEmail"
            name="email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >

          <label for="popupService">What do you need help with?</label>
          <select id="popupService" name="service">
            <option value="Not sure yet">Select a service</option>
            {services.map((service) => (
              <option value={service.value}>{service.label}</option>
            ))}
          </select>

          <label for="popupMessage">Tell us about your project</label>
          <textarea
            id="popupMessage"
            name="message"
            rows="3"
            placeholder="Share your ideas, goals or project requirements..."
            required
          ></textarea>

          <button class="button button-gold" type="submit">
            Send enquiry <span aria-hidden="true">↗</span>
          </button>

          <p class="form-note">
            Your email app will open with your enquiry ready to send.
            See our <a href="/privacy-policy/">privacy notice</a>.
          </p>

          <p class="form-status" role="status" aria-live="polite"></p>

        </form>

      </div>
    </div>
  </dialog>
)}
