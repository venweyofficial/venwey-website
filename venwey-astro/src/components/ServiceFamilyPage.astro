---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import WhatsAppFloat from "./WhatsAppFloat.astro";

interface Props {
  family: "Lab" | "Grow";
  title: string;
  description: string;
  lead: string;
  detail: string;
  seoTitle: string;
  bodyClass?: string;
}

const { family, title, description, lead, detail, seoTitle, bodyClass } = Astro.props;
const familyName = `Venwey ${family}`;
---

<BaseLayout title={seoTitle} description={description} bodyClass={bodyClass}>
  <Header />

  <main id="main-content">
    <section class="service-detail section-pad" aria-labelledby="service-title">
      <div class="container service-detail-content">
        <nav aria-label="Breadcrumb" class="service-breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href={`/services/${family.toLowerCase()}/`}>{family}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <p class="eyebrow">{familyName} · Digital Services</p>
        <h1 id="service-title">{title}</h1>
        <p class="service-detail-lead">{lead}</p>
        <p>{detail}</p>

        <div class="service-detail-actions">
          <a class="button button-dark" href="/contact/" data-service={family}>
            Discuss a {family.toLowerCase()} project
          </a>
          <a class="underlined-link" href={`/services/${family.toLowerCase()}/`}>
            Explore all {family} services
          </a>
        </div>
      </div>
    </section>

    <slot name="services" />
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
