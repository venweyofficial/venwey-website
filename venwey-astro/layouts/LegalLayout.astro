---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  current: "privacy" | "terms" | "disclaimer";
}

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="legal-document">
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a class="logo-link" href="/" aria-label="Venwey home"><span class="logo-slot logo-slot--header"><img src="/assets/logo.png" alt="Venwey" /></span></a>
      <a class="nav-contact" href="/">Back to Venwey</a>
    </nav>
  </header>
  <main class="legal-main">
    <article class="container legal-content">
      <slot />
    </article>
  </main>
  <footer class="footer legal-footer">
    <div class="container footer-bottom">
      <span>© 2026 Venwey</span>
      <nav class="footer-legal" aria-label="Legal information">
        <a href="/privacy-policy/" aria-current={current === "privacy" ? "page" : undefined}>Privacy Policy</a>
        <a href="/terms/" aria-current={current === "terms" ? "page" : undefined}>Terms &amp; Conditions</a>
        <a href="/disclaimer/" aria-current={current === "disclaimer" ? "page" : undefined}>Disclaimer</a>
      </nav>
      <a href="/">Back to home</a>
    </div>
  </footer>
</BaseLayout>
