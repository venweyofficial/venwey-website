
---
---

<footer class="footer" aria-label="Venwey website footer">

  <div class="container footer-top">

    <a class="logo-link" href="/" aria-label="Venwey homepage">
      <span class="logo-slot logo-slot--footer">
        <img
          src="/assets/logo-light.png"
          alt="Venwey logo"
          onerror="this.parentElement.classList.add('is-empty');this.remove()"
        >
        <em class="slot-label">
          Logo space (light version)<br>
          <small>assets/logo-light.png</small>
        </em>
      </span>
    </a>

    <a class="back-top" href="/" aria-label="Back to homepage">
      Back to top ↑
    </a>

  </div>

  <div class="container footer-directory">

    <!-- Explore -->
    <nav class="footer-column" aria-label="Explore Venwey">
      <h2>Explore Venwey</h2>
      <a href="/about/">About Us</a>
      <a href="/services/">What We Do</a>
      <a href="/about/vision-mission/">Our purpose</a>
    </nav>

    <!-- Services -->
    <nav class="footer-column" aria-label="Venwey services">
      <h2>Our Services</h2>

      <a href="/services/branding/">
        Branding & Visual Identity
      </a>

      <a href="/services/lab/">
        Website & Digital Product Development
      </a>

      <a href="/services/grow/">
        Digital Marketing & SEO
      </a>
    </nav>

    <!-- Contact -->
    <div class="footer-column">
      <h2>Contact Venwey</h2>

      <a
        class="footer-social-link"
        href="mailto:venweyofficial@gmail.com"
        aria-label="Email Venwey"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
        <span>Email Us</span>
      </a>

      <a
        class="footer-social-link"
        href="tel:+919496011781"
        aria-label="Call Venwey"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z"></path>
        </svg>
        <span>Call our team</span>
      </a>

      <a
        class="footer-social-link"
        href="https://wa.me/919496011781"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contact Venwey on WhatsApp"
      >
        <svg class="whatsapp-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M16.04 3.2A12.7 12.7 0 0 0 5.1 22.35L3.4 28.6l6.4-1.68A12.7 12.7 0 1 0 16.04 3.2Zm0 22.95c-1.95 0-3.86-.52-5.53-1.5l-.4-.24-3.8 1 1.02-3.7-.26-.42a10.25 10.25 0 1 1 8.97 4.86Zm5.63-7.68c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.13 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"></path>
        </svg>
        <span>WhatsApp</span>
      </a>

      <a
        class="footer-social-link"
        href="https://www.instagram.com/venweyofficial/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow Venwey on Instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle class="instagram-flash" cx="17.5" cy="6.8" r="1"></circle>
        </svg>
        <span>Instagram</span>
      </a>

    </div>

  </div>

  <!-- Legal and Copyright -->
  <div class="container footer-bottom">

    <nav class="footer-legal" aria-label="Legal information">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms/">Terms & Conditions</a>
      <a href="/disclaimer/">Disclaimer</a>
    </nav>

    <span>
      © <span id="year"></span> Venwey. All rights reserved.
    </span>

  </div>

</footer>
